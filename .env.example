# ── swarn-backend settings (prefix BACKEND_) ─────────────────────────────────
# Copy to .env. Anything starting with SWARN_ is passed through to the job
# workers untouched (model endpoint, sandbox, loop limits — see agent2).

BACKEND_DATABASE_URL=postgresql+asyncpg://swarn:password@127.0.0.1:5432/swarn_backend

BACKEND_S3_ENDPOINT=http://127.0.0.1:9000
BACKEND_S3_ACCESS_KEY=minioadmin
BACKEND_S3_SECRET_KEY=minioadmin
BACKEND_S3_BUCKET=swarn
BACKEND_S3_REGION=us-east-1

# The origin users type in the browser. Used for the OAuth redirect URI,
# the Origin check on state-changing requests and the cookie's Secure flag.
BACKEND_PUBLIC_URL=http://localhost:8000
# Where the sign-in callback sends the browser afterwards (the Next.js app).
BACKEND_FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 client (type: Web application). Authorised redirect URI:
#   <BACKEND_PUBLIC_URL>/api/auth/google/callback
BACKEND_GOOGLE_CLIENT_ID=
BACKEND_GOOGLE_CLIENT_SECRET=
# Comma-separated allow rules; set at least one on any shared deployment.
BACKEND_ALLOWED_EMAIL_DOMAINS=
BACKEND_ALLOWED_EMAILS=
BACKEND_ADMIN_EMAILS=

# 32+ random bytes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
BACKEND_SECRET_KEY=change-me

# Browser session lifetime
BACKEND_SESSION_MAX_DAYS=7
BACKEND_SESSION_IDLE_HOURS=12
BACKEND_CLI_SESSION_MAX_DAYS=90
# 1 only for plain-http localhost development
BACKEND_INSECURE_COOKIES=1

# Development only: when the Google client id is empty and this is 1,
# GET /api/auth/dev-login?email=you@example.com signs that address in without
# Google. Never enable on a shared deployment.
BACKEND_DEV_LOGIN=0

# Only when the frontend is served from another origin (local dev on :3000)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Job execution
BACKEND_WORK_DIR=./work
BACKEND_JOB_CONCURRENCY=2
BACKEND_MAX_RUNNING_PER_USER=2
BACKEND_APPROVAL_TIMEOUT_S=1800
BACKEND_CANCEL_GRACE_S=60
BACKEND_MAX_UPLOAD_MB=512
BACKEND_STAGE_MAX_GB=20
BACKEND_HYDRATE_MAX_MB=2048
BACKEND_DATASET_CACHE_MB=1024
BACKEND_KEEP_FAILED_WORKDIRS=0
BACKEND_EXPOSE_DOCS=1
BACKEND_LOG_LEVEL=INFO

# ── passed through to workers (agent2 settings) ──────────────────────────────
SWARN_DEPLOYED_MODEL=
SWARN_DEPLOYED_BASE_URL=
SWARN_DEPLOYED_API_KEY=
SWARN_SANDBOX=docker
# SWARN_SANDBOX_MEM=2g
# SWARN_SANDBOX_CPUS=2
# SWARN_MAX_ITERATIONS=30
# SWARN_PRICE_IN_PER_MTOK=0
# SWARN_PRICE_OUT_PER_MTOK=0
